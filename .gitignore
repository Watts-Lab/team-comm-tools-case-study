# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Embedding cache produced by team_comm_tools (large, fully regenerable)
outputs/vector_cache/

# Step 17 moves the cache aside before timing a cold initialization. The copy it
# leaves behind is the same 2.2 GB of vectors, so it is not tracked either.
outputs/vector_cache_backup/

# Logs
*.log

# OS
.DS_Store

# FeatureBuilder's log tree (step 2 points it at outputs/logs/; *.log above
# already covers the files, this drops the empty directory too).
outputs/logs/

# FeatureBuilder's own output tree. Large (340 MB), fully regenerated by
# scripts/02_extract_features.py, and read only by step 3 - which ships its own
# output, data/processed/analysis_*.csv, so the analysis can be re-run without it.
outputs/features/

# Step 9's FeatureBuilder output tree for the cumulative block. Same rationale as
# outputs/features/ above: large (674 MB) and fully regenerated by
# scripts/09_extract_cumulative_features.py.
outputs/features_cumulative/

# Large regenerable dataframes from the window chain. Both are expansions of
# tables that ARE tracked: chat_cumulative_* repeats chat_*.csv once per later
# round (40 MB, written by scripts/08_cumulative_chat.py), and analysis_windows_*
# adds the cumulative feature block to analysis_*.csv (67 MB, written by
# scripts/10_build_windows_table.py).
data/processed/chat_cumulative_*.csv
data/processed/analysis_windows_*.csv
